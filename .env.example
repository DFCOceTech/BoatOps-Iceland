# BoatOps — environment variables template
# Copy to .env and fill in your credentials.
# NEVER commit .env to version control.
# Variable names must match exactly what pydantic-settings reads in config.py.

# ── CMEMS (copernicusmarine client) ──────────────────────────────────────────
COPERNICUSMARINE_SERVICE_USERNAME=your_cmems_username
COPERNICUSMARINE_SERVICE_PASSWORD=your_cmems_password

# ── CDSE (Copernicus Data Space Ecosystem — Sentinel-2 imagery) ───────────────
CDSE_EMAIL=your_cdse_email@example.com
CDSE_PASSWORD=your_cdse_password

# ── CORS ──────────────────────────────────────────────────────────────────────
# Set to your production domain (JSON list of allowed origins).
# In production behind nginx (same-origin serving): leave as [] — no CORS needed.
# Example for a separate frontend host: CORS_ORIGINS=["https://boatops.example.com"]
CORS_ORIGINS=[]

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ── AI synthesis (optional — FR-16, placeholder in UI) ───────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
