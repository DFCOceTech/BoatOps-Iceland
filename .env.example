# BoatOps Iceland — environment variables template
# Copy to .env and fill in your credentials. NEVER commit .env.

# ── CDSE (Copernicus Data Space Ecosystem — Sentinel-1 SAR + Sentinel-2 imagery) ──
# Free account: https://dataspace.copernicus.eu  (without it, weather/tide/solar/overpasses still work)
CDSE_EMAIL=your_cdse_email@example.com
CDSE_PASSWORD=your_cdse_password

# Same-origin behind nginx: leave empty.
CORS_ORIGINS=[]
LOG_LEVEL=info
